{
  "name": "triviastream-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TriviaStream API \u2014 Express + Socket.IO + MongoDB",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:quizzes": "tsx --env-file-if-exists=.env src/scripts/migrate-quizzes-to-themes.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
