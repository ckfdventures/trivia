# Server
PORT=8001

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=triviastream

# Comma-separated list of allowed browser origins (e.g. https://trivia.example.com), or * for any
CORS_ORIGINS=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_HOURS=24

# Owner/admin account. Created on startup; if the password here changes, the stored one is updated.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too
